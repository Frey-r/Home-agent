{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domotica.home/schemas/llm.v1.json",
  "title": "LLM Protocol v1",
  "description": "Esquema neutro para solicitudes y respuestas de LLM (Hito M2a / ADR-0008)",
  "oneOf": [
    { "$ref": "#/$defs/Request" },
    { "$ref": "#/$defs/Response" }
  ],
  "$defs": {
    "Role": {
      "type": "string",
      "enum": ["system", "user", "assistant"]
    },
    "TextBlock": {
      "type": "object",
      "properties": {
        "type": { "const": "text" },
        "text": { "type": "string" }
      },
      "required": ["type", "text"],
      "additionalProperties": false
    },
    "ImageBlock": {
      "type": "object",
      "properties": {
        "type": { "const": "image" },
        "media_type": {
          "type": "string",
          "enum": ["image/jpeg", "image/png", "image/webp", "image/gif"]
        },
        "data": { "type": "string", "minLength": 1 }
      },
      "required": ["type", "media_type", "data"],
      "additionalProperties": false
    },
    "ToolCallBlock": {
      "type": "object",
      "properties": {
        "type": { "const": "tool_call" },
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "arguments": { "type": ["object", "string"] }
      },
      "required": ["type", "id", "name", "arguments"],
      "additionalProperties": false
    },
    "ToolResultBlock": {
      "type": "object",
      "properties": {
        "type": { "const": "tool_result" },
        "tool_call_id": { "type": "string", "minLength": 1 },
        "content": { "type": "string" },
        "is_error": { "type": "boolean" }
      },
      "required": ["type", "tool_call_id", "content"],
      "additionalProperties": false
    },
    "ContentBlock": {
      "oneOf": [
        { "$ref": "#/$defs/TextBlock" },
        { "$ref": "#/$defs/ImageBlock" },
        { "$ref": "#/$defs/ToolCallBlock" },
        { "$ref": "#/$defs/ToolResultBlock" }
      ]
    },
    "Message": {
      "type": "object",
      "properties": {
        "role": { "$ref": "#/$defs/Role" },
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/ContentBlock" }
        }
      },
      "required": ["role", "content"],
      "additionalProperties": false
    },
    "Tool": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "parameters": {
          "type": "object",
          "properties": {
            "type": { "const": "object" }
          },
          "required": ["type"]
        }
      },
      "required": ["name", "description", "parameters"],
      "additionalProperties": false
    },
    "StopReason": {
      "type": "string",
      "enum": ["end", "tool_calls", "max_tokens", "refusal", "error"]
    },
    "Usage": {
      "type": "object",
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "cache_read_tokens": { "type": "integer", "minimum": 0 },
        "cache_write_tokens": { "type": "integer", "minimum": 0 }
      },
      "required": ["input_tokens", "output_tokens"],
      "additionalProperties": false
    },
    "RequestOptions": {
      "type": "object",
      "properties": {
        "temperature": { "type": "number", "minimum": 0.0, "maximum": 2.0 },
        "max_tokens": { "type": "integer", "minimum": 1 },
        "tool_choice": { "type": ["string", "object"] }
      },
      "additionalProperties": false
    },
    "Request": {
      "type": "object",
      "properties": {
        "system": { "type": "string" },
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/Message" }
        },
        "tools": {
          "type": "array",
          "items": { "$ref": "#/$defs/Tool" }
        },
        "options": { "$ref": "#/$defs/RequestOptions" }
      },
      "required": ["messages"],
      "additionalProperties": false
    },
    "Response": {
      "type": "object",
      "properties": {
        "message": { "$ref": "#/$defs/Message" },
        "stop_reason": { "$ref": "#/$defs/StopReason" },
        "usage": { "$ref": "#/$defs/Usage" }
      },
      "required": ["message", "stop_reason", "usage"],
      "additionalProperties": false
    }
  }
}
